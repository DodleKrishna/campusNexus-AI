# CampusNexus AI - environment variables
#
# Placeholders documenting config expected by each phase, per CLAUDE.md's
# "no inline secrets/config" rule.

# LLM provider credentials (Phase 3+: agents/orchestration). Only the key for
# the selected CAMPUSNEXUS_LLM_PROVIDER is read. Never commit real keys.
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# SQLite persistence path (Phase 2: database foundation + Context Service).
# Optional -- defaults to ./data/campusnexus.db (repo-relative) if unset.
# The test suite never reads this file's value; it points its own isolated
# temp database at CAMPUSNEXUS_DB_PATH per test run.
CAMPUSNEXUS_DB_PATH=./data/campusnexus.db

# Phase 2.5: local (SQLite: offline edge, tests) or postgres (Supabase; CAMPUSNEXUS_DATABASE_URL required,
# never falls back to SQLite). Empty = postgres when the URL below names PostgreSQL, else local.
CAMPUSNEXUS_DATABASE_MODE=
# Phase 21: the application database as a URL. Takes priority over CAMPUSNEXUS_DB_PATH.
# Empty = SQLite (CAMPUSNEXUS_DB_PATH, else ./data/campusnexus.db): local, offline, tests.
# PostgreSQL / Supabase: the Session pooler connection string (port 5432, IPv4; right for a persistent backend).
# The driver is used as written: postgresql+psycopg://... or postgresql+pg8000://... (bare postgresql:// = psycopg);
# needs `pip install -e ".[postgres]"`. Supabase hosts always use SSL (sslmode=require when unset).
# Holds the database password: set it only in your shell or a git-ignored .env, never commit it.
CAMPUSNEXUS_DATABASE_URL=
# Optional bounded pool settings (PostgreSQL): CAMPUSNEXUS_DB_POOL_SIZE (1-20, default 5),
# CAMPUSNEXUS_DB_MAX_OVERFLOW (0-20, 5), CAMPUSNEXUS_DB_POOL_TIMEOUT (1-120 s, 30),
# CAMPUSNEXUS_DB_CONNECT_TIMEOUT (psycopg, 1-120 s, 15), CAMPUSNEXUS_DB_SOCKET_TIMEOUT (pg8000, 5-600 s, 60).

# ChromaDB persistence directory (Phase 3: Knowledge/RAG retrieval infrastructure).
# Optional -- defaults to ./data/chroma (repo-relative) if unset. Generated vector
# store contents are gitignored; only this path configuration is checked in.
CAMPUSNEXUS_VECTOR_STORE_PATH=./data/chroma

# Policy document corpus directory ingested by scripts/ingest_policies.py.
# Optional -- defaults to ./data/policies if unset.
CAMPUSNEXUS_POLICY_DIR=./data/policies

# Embedding provider for the RAG pipeline (app/rag/embeddings.py):
#   onnx_minilm   -- local ONNX all-MiniLM-L6-v2 (chromadb-bundled). Real
#                    semantic embeddings, runs fully locally after a one-time
#                    model download on first use. Production/demo default.
#   deterministic -- offline hashing-trick embedding, no model download, no
#                    network. Always used by the test suite; a safe fallback
#                    if the demo machine has no network access.
# Optional -- defaults to onnx_minilm if unset.
CAMPUSNEXUS_EMBEDDING_PROVIDER=onnx_minilm

# Informational: the model the onnx_minilm provider uses. Not yet threaded
# through to select a different model -- documents the production/demo choice.
CAMPUSNEXUS_EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM provider for every agent and the Mission Orchestrator (app/llm/factory.py):
#   mock      -- deterministic, offline, no credentials, no network. Always
#                used by the test suite and the eval runner; the demo/app
#                default so the full workflow runs with zero setup.
#   anthropic -- real Claude, via ANTHROPIC_API_KEY. Requires the optional
#                "llm" extra (`pip install -e ".[dev,llm]"`).
#   groq      -- real model on Groq's OpenAI-compatible API, via GROQ_API_KEY.
#                Uses httpx (already installed); no vendor SDK.
# Optional -- defaults to mock if unset.
CAMPUSNEXUS_LLM_PROVIDER=mock

# Model id for the selected real provider. Leave empty for the provider's
# default: anthropic -> claude-sonnet-5 (also claude-opus-5, claude-haiku-4-5);
# groq -> openai/gpt-oss-120b (any Groq model that supports tool calling, e.g.
# llama-3.3-70b-versatile). A Claude id is refused when the provider is groq.
CAMPUSNEXUS_LLM_MODEL=

# Per-request timeout (seconds) for the real LLM provider; failed requests are
# retried twice (rate limits, 5xx, network errors).
# Optional -- defaults to 60.
CAMPUSNEXUS_LLM_TIMEOUT_SECONDS=60

# Groq only: how many Groq API calls may be in flight at once (per process).
# The free tier's tokens-per-minute limit is exhausted by parallel mission
# tasks, so the default is 1 -- tasks still run in parallel, only their Groq
# calls queue. Raise it on a paid tier. Mock and Anthropic are never throttled.
# Optional -- defaults to 1.
CAMPUSNEXUS_LLM_MAX_CONCURRENCY=1

# Streamlit UI only: where the FastAPI backend is, and how long the UI waits for a
# mission create/resume call before giving up (the mission keeps running server-side).
# Optional -- default to http://127.0.0.1:8000 and 300.
CAMPUSNEXUS_API_URL=http://127.0.0.1:8000
CAMPUSNEXUS_UI_MISSION_TIMEOUT_SECONDS=300

# Phase 15 auth: JWT signing secret. Optional -- unset means a random secret per API
# process (a restart signs everyone out). Never commit a real value.
CAMPUSNEXUS_JWT_SECRET=
# Optional fixed password for the local development sign-in accounts, used when
# reset_demo_env.py / seed_data.py seed them. Unset = generated and written to the
# git-ignored data/**/dev_credentials.txt (always rewritten with the seeded password).
CAMPUSNEXUS_DEMO_PASSWORD=

# --- AgentOS V2 Phase 5.1: live voice calls (Exotel + Groq speech). Leave unset to keep voice unavailable. ---
# Speech reuses GROQ_API_KEY above. Without it (or without a TTS voice) voice streams are refused; fake speech is
# never used outside tests.
CAMPUSNEXUS_STT_PROVIDER=groq
CAMPUSNEXUS_TTS_PROVIDER=groq
CAMPUSNEXUS_STT_MODEL=whisper-large-v3-turbo
CAMPUSNEXUS_TTS_MODEL=canopylabs/orpheus-v1-english
# One of the TTS model's voices (e.g. hannah, autumn, diana, austin, daniel, troy).
CAMPUSNEXUS_TTS_VOICE=
# Optional: the restricted voice brain's model (default openai/gpt-oss-20b), STT language, provider timeout (1-30 s).
CAMPUSNEXUS_VOICE_BRAIN_MODEL=
CAMPUSNEXUS_STT_LANGUAGE=en
CAMPUSNEXUS_VOICE_PROVIDER_TIMEOUT_SECONDS=8
# Exotel (shell only, never committed). Voice is offered only when all of these are set.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_FLOW_APP_ID=
# Public https base URL Exotel reaches (status callbacks; the flow's Voicebot stream URL comes from
# GET /communication/exotel/stream-url, which returns a wss URL at sample-rate=16000).
CAMPUSNEXUS_PUBLIC_BASE_URL=
# Optional secret for signed callback/stream tokens (unset = random per process).
CAMPUSNEXUS_VOICE_TOKEN_SECRET=
# Live Exotel smoke only (scripts/exotel_voice_smoke.py): the one number it may call.
CAMPUSNEXUS_TEST_PHONE=

# --- AgentOS V2 Phase 6: offline edge intelligence + local Nexus voice. Leave unset for the Phase 2 behaviour. ---
# cloud = the cloud brain only (CAMPUSNEXUS_AGENT_BRAIN, default groq); local = Ollama only (zero cloud AI calls);
# auto = cloud while reachable, Ollama when offline or on a cloud transport failure (never on budget/malformed output).
CAMPUSNEXUS_INTELLIGENCE_MODE=
CAMPUSNEXUS_LOCAL_LLM_PROVIDER=ollama
# Loopback / private-network only (set CAMPUSNEXUS_OLLAMA_ALLOW_REMOTE_HOST=1 to allow another host; never metadata IPs).
CAMPUSNEXUS_OLLAMA_BASE_URL=http://127.0.0.1:11434
CAMPUSNEXUS_OLLAMA_MODEL=gpt-oss:20b
CAMPUSNEXUS_OLLAMA_TIMEOUT_SECONDS=60
# Optional smaller model, used ONLY when the policy below is model_unavailable and the primary model is not installed.
CAMPUSNEXUS_OLLAMA_FALLBACK_MODEL=
CAMPUSNEXUS_OLLAMA_FALLBACK_POLICY=
# Connectivity: one bounded TCP probe to the cloud provider endpoint, cached. 1 = developer/edge offline mode
# (always offline, every cloud provider refused).
CAMPUSNEXUS_OFFLINE_MODE=
CAMPUSNEXUS_CONNECTIVITY_PROBE_URL=https://api.groq.com
CAMPUSNEXUS_CONNECTIVITY_CACHE_SECONDS=30
CAMPUSNEXUS_CONNECTIVITY_TIMEOUT_SECONDS=2
# In-app voice (POST /agentos/assistant/voice): cloud | local | auto (TTS defaults to the speech mode).
CAMPUSNEXUS_SPEECH_MODE=
CAMPUSNEXUS_TTS_MODE=
# Local speech: absolute paths to binaries/models you installed yourself (nothing is downloaded).
CAMPUSNEXUS_WHISPER_CPP_PATH=
CAMPUSNEXUS_WHISPER_MODEL_PATH=
# Local TTS: kokoro (preferred; kokoro-onnx, in-process) or piper (explicit option; unset = piper). The selected
# provider is the only one used: an unavailable Kokoro is reported unavailable, never replaced by Piper.
CAMPUSNEXUS_LOCAL_TTS_PROVIDER=kokoro
CAMPUSNEXUS_KOKORO_MODEL_PATH=
CAMPUSNEXUS_KOKORO_VOICES_PATH=
CAMPUSNEXUS_KOKORO_VOICE=af_heart
# 0.75-1.15 (anything else is a configuration error).
CAMPUSNEXUS_KOKORO_SPEED=0.88
CAMPUSNEXUS_KOKORO_LANG=en-us
CAMPUSNEXUS_PIPER_PATH=
CAMPUSNEXUS_PIPER_MODEL_PATH=
CAMPUSNEXUS_LOCAL_SPEECH_TIMEOUT_SECONDS=30
