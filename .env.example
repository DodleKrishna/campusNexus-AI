# CampusNexus AI - environment variables
#
# Phase 1 (current scaffold: schemas + tests only) does not read any of these
# yet. They are placeholders documenting config expected by later phases, per
# CLAUDE.md's "no inline secrets/config" rule.

# LLM provider credentials (Phase 3+: agents/orchestration)
ANTHROPIC_API_KEY=

# SQLite persistence path (Phase 2+: Context Service)
CAMPUSNEXUS_DB_PATH=./data/campusnexus.db

# ChromaDB persistence directory (Phase 4+: Knowledge/RAG Agent)
CAMPUSNEXUS_VECTOR_STORE_PATH=./data/chroma
